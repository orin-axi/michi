{
  "name": "@orin-axi/michi",
  "version": "0.1.1",
  "description": "AXI response primitives for agent-ergonomic tools",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orin-axi/michi.git",
    "directory": "packages/michi-node"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "napi build --platform --js index.js --dts index.d.ts",
    "test": "node --test __test__/index.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware .",
    "check": "pnpm typecheck && pnpm lint",
    "prepublishOnly": "napi prepublish -t npm"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "@types/node": "^26.1.0",
    "oxlint": "^1.72.0",
    "oxlint-tsgolint": "^0.24.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 18"
  }
}
